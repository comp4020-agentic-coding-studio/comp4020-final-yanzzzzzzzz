node_modules/
dist/
*.log

# local throwaway data dirs for manual testing against DATA_DIR=./something
.data-test/
.data*/

# local-only scratch scripts for spawning a throwaway server/test run against
# an isolated port + DATA_DIR during development — not part of the app
.devtools/
.test-server-*.pid

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory is machine-local: settings in here can hold
# your course API key, and this repo goes public when you ship. Your tracked
# harness is CLAUDE.md (and any AGENTS.md), not this directory.
.claude/
